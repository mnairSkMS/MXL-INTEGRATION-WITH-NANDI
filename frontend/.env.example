# Skandha Transcoder channel UI

# Base URL for the management API. Leave empty for both shipped modes:
#   - the built SPA is served by the API itself at /channel, so it is same-origin
#   - `npm run dev` proxies /config, /inputs and /hls to localhost:8080 (see vite.config.ts)
# Set it only when pointing a dev server at an appliance on another host, e.g.
#   VITE_API_BASE_URL=http://192.168.1.10:8080
VITE_API_BASE_URL=
