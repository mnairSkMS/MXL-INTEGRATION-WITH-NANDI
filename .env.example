# Settings for docker-compose.yml. Copy to .env (git-ignored by convention) and uncomment
# what you want to change. Every value shown is the default.

# Channel file to run: any engine JSON in config/.
#CHANNEL=rtmp_to_hls.json
#   rtmp_to_hls.json        RTMP in (set the stream key), HLS out
#   srt_to_hls_srt.json     SRT in, HLS + SRT out
#   rtmp_to_srt_hls.json    RTMP in, SRT + HLS out
#   config.json             SRT in, HLS + SRT listener out
#   ui_channel.json         playlist in, SRT out (see docker-compose.ui.yml for the UI variant)

# Interface the management API/UI listens on. It is unauthenticated and PUT /config writes:
# keep 127.0.0.1 unless the network is trusted.
#UI_BIND=127.0.0.1

#TRANSCODER_IMAGE=skandha-transcoder:local
#CONTAINER_NAME=skandha-transcoder

# Host ports
#API_HOST_PORT=8080
#SRT_HOST_PORT=9092
#RTMP_HOST_PORT=1935
#HLS_LAN_HOST_PORT=8081

# Licence copied into runtime/license on first run.
#LICENSE_FILE=./transcoder/license/prod/licenses/offline.lic

# Playlist channels only (CHANNEL reads a pls+file:// input). Name a YAML in config/ to apply it
# on every start; PLAYLIST_BOOTSTRAP_WRITEBACK=true lets Publish rewrite it.
#PLAYLIST_BOOTSTRAP_FILE=/opt/utpl/channel/channel.yml
#PLAYLIST_BOOTSTRAP_WRITEBACK=false
