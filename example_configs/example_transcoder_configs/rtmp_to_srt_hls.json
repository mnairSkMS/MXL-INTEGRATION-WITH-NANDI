{
    "version": "1.4.2",
    "application": {
        "logger": {
            "transcoder": {
                "level": "log",
                "console": {
                    "enable": true,
                    "colors": true,
                    "stderr": true
                }
            },
            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true,
                    "stderr": false
                }
            }
        }
    },
    "transcoder": {
        "inputs": [
            {
                "transport": {
                    "uri": "rtmp://103.248.72.28:1935/live/Cook_Vook_Out"
                }
            }
        ],
        "outputs": [
            {
                "name": "srt-hls-output",
                "type": "single",
                "transports": [
                    {
                        "uri": "srt://0.0.0.0:9092?mode=listener",
                        "srt": {
                            "mode": "listener",
                            "latency": 120
                        }
                    },
                    {
                        "uri": "hls+file:/runtime/hls",
                        "hls": {
                            "numSegments": 6,
                            "segmentLength": 4,
                            "singleDirectory": true,
                            "vodMode": false,
                            "adMarkers": [
                                "enhanced"
                            ]
                        }
                    }
                ],
                "container": "mpegts",
                "streams": [
                    {
                        "type": "audio",
                        "codec": "passthrough"
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 1920,
                            "height": 1080,
                            "rate": 25,
                            "format": "I420"
                        },
                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max": "50",
                                "tune": "zerolatency",
                                "speed-preset": "veryfast",
                                "bitrate": "6000"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ],
                "scte": {
                    "mode": "passthrough",
                    "pid": 543
                }
            }
        ]
    }
}
