      {
        "name": "low_band",
        "windows": {
          "input": {
            "x": -1,
            "y": -1,
            "width": -1,
            "height": 0.351852
          },
          "output": {
            "x": -1,
            "y": -1,
            "width": -1,
            "height": 0.351852
          }
        }
      }
    ]
  }
}
