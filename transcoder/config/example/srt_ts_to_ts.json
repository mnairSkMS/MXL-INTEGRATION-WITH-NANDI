{
  "version": "1.1.0",
  "application": {
    "logger": {
      "transcoder": {
        "level": "trace",
        "console": {
          "enable": true,
          "colors": true
        }
      },
      "gstreamer": {
        "level": "log",
        "console": {
          "enable": true,
          "colors": true
        }
      }
    }
  },
  "transcoder": {
    "inputs": [
      {
        "transport": {
          "uri": "srt://127.0.0.1:2222",
          "srt": {
            "mode": "caller",
            "latency": 120,
            "bufferSize": 0
          }
        }
      }
    ],
    "outputs": [
      {
        "transports": [
          {
            "uri": "srt://127.0.0.1:4444",
            "mode": "caller",
            "latency": 120,
            "bufferSize": 0
          }
        ],
        "container": "mpegts",
        "scte": {
          "pid": 600,
          "mode": "passthrough"
        },
        "streams": [
          {
            "type": "audio",
            "codec": "ac3",
            "audio": {
              "rate": 48000,
              "channels": 2
            },
            "ac3": {
              "encoder": "dlbpatenc",
              "properties": {
                "dialnorm": "-24",
                "drc-line": "auto",
                "drc-rf": "auto",
                "surround-trim": "auto",
                "height-trim": "auto"
              },
              "caps": {}
            }
          },
          {
            "type": "video",
            "codec": "h264",
            "video": {
              "width": 1280,
              "height": 720,
              "rate": 24
            },
            "h264": {
              "encoder": "x264enc",
              "properties": {
                "key-int-max": "15",
                "tune": "zerolatency",
                "speed-preset": "ultrafast",
                "bitrate": "3500"
              },
              "caps": {
                "profile": "high"
              }
            }
          }
        ]
      }
    ],
    "squeeze": [
      {
        "name": "l_shape",
        "windows": {
          "input": {
            "x": -1,
            "y": -1,
            "width": -1,
            "height": -1
          },
          "output": {
            "x": 0.078125,
            "y": 0.0,
            "width": -1,
            "height": 0.588889
          }
        }
      },
      {
        "name": "low_band",
        "windows": {
          "input": {
            "x": -1,
            "y": -1,
            "width": -1,
            "height": 0.527778
          },
          "output": {
            "x": -1,
            "y": -1,
            "width": -1,
            "height": 0.527778
          }
        }
      }
    ]
  }
}
