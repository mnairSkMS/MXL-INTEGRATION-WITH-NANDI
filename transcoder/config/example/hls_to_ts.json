{
    "version": "1.1.0",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true,
                    "stderr": false
                }
            },
            
            "gstreamer": {
                "level": "warning",
                "file": {
                    "enable": true,
                    "path": "/opt/utpl/var/log/gstreamer.log"
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "transport": {
                    "uri": "https://bitdash-a.akamaihd.net/content/MI201109210084_1/m3u8s/f08e80da-bf1d-4e3d-8899-f0f6155f6efa.m3u8"
                }
            }
        ],

        "outputs": [
            {
                "transports": [
                    {
                        "uri": "udp://127.0.0.1:5000"
                    }
                ],

                "container": "mpegts",
                "streams": [
                    {
                        "type": "audio",
                        "codec": "ac3",
                        "audio": {
                            "rate": 48000,
                            "channels": 6
                        },
                        "ac3": {
                            "encoder": "dlbpatenc",
                            "properties": {
                                "dialnorm": "-24",
                                "drc-line": "auto",
                                "drc-rf": "auto",
                                "surround-trim": "auto",
                                "height-trim": "auto"
                            },
                            "caps": {

                            }
                        }
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 640,
                            "height": 480
                        },

                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "15",
                                "tune":         "zerolatency",
                                "speed-preset": "ultrafast",
                                "bitrate":      "3500"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ]
            }
        ]
    }
}
