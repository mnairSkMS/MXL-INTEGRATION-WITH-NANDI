{
    "version": "1.3.0",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warn",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "transport": {
                    "uri": "udp://127.0.0.1:2222"
                }
            }
        ],

        "outputs": [
            {
                
                "transports": [
                    {
                        "uri": "http://127.0.0.1:9876",
                        "hls": {
                            "credentials": {
                                "username": "user",
                                "password": "password"
                            },
                            "numSegments": 5,
                            "segmentLength": 5,
                            "singleDirectory": true,
                            "vodMode": false,
                            "transferMode": "http_dav"
                        }
                    }
                ],

                "container": "mpegts",

                "scte": {
                    "pid": 600,
                    "mode": "passthrough"
                },

                "streams": [
                    {
                        "type": "audio",
                        "codec": "mp3",
                        "audio": {
                            "rate": 44100,
                            "channels": 2
                        }
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 1280,
                            "height": 720,
                            "rate": 24
                        },
                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "15",
                                "tune":         "zerolatency",
                                "speed-preset": "ultrafast",
                                "bitrate":      "3500"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ]
            }
        ]
    }
}
