From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: antony-rajj <araj@skandhams.com>
Date: Tue, 27 Oct 2026 13:02:45 +0530
Subject: [PATCH 1/3] dashsink2: let the first handler that returns a stream
 win

The get-*-stream signals have default class handlers that open files under
mpd-root-path. They run last and the signals had no accumulator, so a stream
returned by an application handler was silently replaced and the application
received no data. Stop the emission at the first handler that returns a stream.
---
 net/dashsink2/src/dashsink2/imp.rs | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/net/dashsink2/src/dashsink2/imp.rs b/net/dashsink2/src/dashsink2/imp.rs
index 967819b0..2b5e0777 100644
--- a/net/dashsink2/src/dashsink2/imp.rs
+++ b/net/dashsink2/src/dashsink2/imp.rs
@@ -32,6 +32,20 @@ const SIGNAL_GET_MANIFEST_STREAM: &str = "get-manifest-stream";
 const SIGNAL_GET_INIT_STREAM: &str = "get-init-stream";
 const SIGNAL_GET_SEGMENT_STREAM: &str = "get-segment-stream";
 
+// The default handlers write to files under mpd-root-path. They run last, so without an
+// accumulator their return value replaced the stream an application handler returned. Stop the
+// emission at the first handler that returns a stream.
+fn first_stream_wins(
+    _hint: &glib::subclass::SignalInvocationHint,
+    acc: glib::Value,
+    ret: &glib::Value,
+) -> std::ops::ControlFlow<glib::Value, glib::Value> {
+    match ret.get::<Option<gio::OutputStream>>() {
+        Ok(Some(_)) => std::ops::ControlFlow::Break(ret.clone()),
+        _ => std::ops::ControlFlow::Continue(acc),
+    }
+}
+
 static CAT: LazyLock<gst::DebugCategory> = LazyLock::new(|| {
     gst::DebugCategory::new(
         "dashsink2",
@@ -275,6 +289,7 @@ impl ObjectImpl for DashSink2 {
                 glib::subclass::Signal::builder(SIGNAL_GET_INIT_STREAM)
                     .param_types([GType::STRING])
                     .return_type::<Option<gio::OutputStream>>()
+                    .accumulator(first_stream_wins)
                     .class_handler(|args| {
                         let location: String = args[1].get().expect("location");
                         let s = DashSink2::new_file_stream(&location).ok();
@@ -284,6 +299,7 @@ impl ObjectImpl for DashSink2 {
                 glib::subclass::Signal::builder(SIGNAL_GET_SEGMENT_STREAM)
                     .param_types([GType::STRING])
                     .return_type::<Option<gio::OutputStream>>()
+                    .accumulator(first_stream_wins)
                     .class_handler(|args| {
                         let location: String = args[1].get().expect("location");
                         let s = DashSink2::new_file_stream(&location).ok();
@@ -293,6 +309,7 @@ impl ObjectImpl for DashSink2 {
                 glib::subclass::Signal::builder(SIGNAL_GET_MANIFEST_STREAM)
                     .param_types([GType::STRING])
                     .return_type::<Option<gio::OutputStream>>()
+                    .accumulator(first_stream_wins)
                     .class_handler(|args| {
                         let location: String = args[1].get().expect("location");
                         let s = DashSink2::new_file_stream(&location).ok();
