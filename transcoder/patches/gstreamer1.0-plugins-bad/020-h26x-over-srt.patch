+static gboolean
+buffer_is_in_caps (GstSRTSink *sink, GstBuffer *buf)
+{
+  gboolean ret = sink->headers != NULL;
+
+  if (ret) {
+    guint n = gst_buffer_list_length(sink->headers);
+    guint i;
+
+    GstMapInfo map;
+
+    gst_buffer_map(buf, &map, GST_MAP_READ);
+
+    ret = FALSE;
+
+    for (i = 0; i < n; i++) {
+        GstBuffer *buf2 = gst_buffer_list_get(sink->headers, i);
+        GstMapInfo map2;
+
+        if (buf == buf2) {
+          ret = TRUE;
+          break;
+        }
+
+        gst_buffer_map (buf2, &map2, GST_MAP_READ);
+        if (
+          (map.size == map2.size) && 
+          (memcmp(map.data, map2.data, map.size) == 0)
+        ) {
+          ret = TRUE;
+        }
+        gst_buffer_unmap(buf2, &map2);
+
+        if (ret) {
+          break;
+        }
+    }
+
+    gst_buffer_unmap(buf, &map);
+  }
+
+  return ret;
+}
