{
    "version": "1.0.7",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "uri": "file:///tmp/input.ts"
            }
        ],

        "outputs": [
            {
                "uri": "file:///tmp/output.ts",
                "container": "mpegts",

                "streams": [
                    {
                        "type": "audio",
                        "codec": "ac3",
                        "audio": {
                            "rate": 48000,
                            "channels": 6
                        },
                        "ac3": {
                            "encoder": "dlbpatenc",
                            "properties": {
                                "dialnorm": "-24",
                                "drc-line": "auto",
                                "drc-rf": "auto",
                                "surround-trim": "auto",
                                "height-trim": "auto"
                            },
                            "caps": {

                            }
                        }
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 640,
                            "height": 480,
                            "rate": 25
                        },

                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "15",
                                "tune":         "zerolatency",
                                "speed-preset": "ultrafast",
                                "bitrate":      "3500"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ]
            }
        ]
    }
}
