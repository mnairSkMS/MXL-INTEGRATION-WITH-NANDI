{
    "version": "1.0.7",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "uri": "srt://127.0.0.1:2222/?mode=caller"
            }
        ],

        "outputs": [
            {
                "uri": "file:///tmp/output.ts",
                "container": "mpegts",

                "streams": [
                    {
                        "type": "audio",
                        "codec": "mp2",
                        "audio": {
                            "channels": 2,
                            "rate": 44100
                        }
                    },
                    {
                        "type": "video",
                        "codec": "h264",

                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "15",
                                "tune":         "zerolatency",
                                "speed-preset": "fast",
                                "bitrate":      "2400"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ]
            }
        ]
    }
}
