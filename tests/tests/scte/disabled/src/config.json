{
    "version": "1.0.7",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "uri": "file:///tmp/input.ts"
            }
        ],

        "outputs": [
            {
                "uri": "file:///tmp/output.ts",
                "container": "mpegts",

                "streams": [
                    {
                        "type": "audio",
                        "codec": "passthrough"
                    },
                    {
                        "type": "video",
                        "codec": "passthrough"
                    }
                ]
            }
        ]
    }
}
