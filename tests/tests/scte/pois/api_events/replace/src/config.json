{
    "version": "1.0.7",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "scte": {
            "pois": {
                "enable": true,
                "server": {
                    "uri": "http://localhost:9876/esam",
                    "acquisitionPointId": "esam-client",
                    "timeout": 1000
                }
            }
        },

        "inputs": [
            {
                "uri": "srt://127.0.0.1:2222/?mode=caller"
            }
        ],

        "outputs": [
            {
                "uri": "file:///tmp/output.ts",
                "container": "mpegts",

                "scte": {
                    "mode": "passthrough",
                    "pid": 765
                },

                "streams": [
                    {
                        "type": "audio",
                        "codec": "passthrough"
                    },
                    {
                        "type": "video",
                        "codec": "passthrough"
                    }
                ]
            }
        ]
    }
}
