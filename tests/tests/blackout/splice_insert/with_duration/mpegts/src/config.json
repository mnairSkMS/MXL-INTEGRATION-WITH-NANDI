{
    "version": "1.0.7",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "uri": "srt://127.0.0.1:2222/?mode=caller"
            }
        ],

        "outputs": [
            {
                "uri": "srt://127.0.0.1:4444/?mode=caller",
                "container": "mpegts",

                "streams": [
                    {
                        "type": "audio",
                        "codec": "mp2",
                        "audio": {
                            "channels": 2,
                            "rate": 44100
                        }
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 960,
                            "height": 540,
                            "rate": 24
                        },
                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "15",
                                "tune":         "zerolatency",
                                "speed-preset": "fast",
                                "bitrate":      "2400"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ]
            }
        ],

        "blackout": {
            "enable": true,

            "restriction": {
                "ignore": "NONE"
            },

            "conditions": {
                "spliceInsert": {
                    "blankWhenNoSegmentationDescriptors": true,
                    "segments": []
                },

                "timeSignal": {
                    "blankWhenNoSegmentationDescriptors": false,
                    "segments": [
                        {
                            "name": "Network",
                            "priority": 1,
                            "start": "0x51",
                            "stop": "0x50"
                        },
                        {
                            "name": "Unscheduled Event",
                            "priority": 2,
                            "start": "0x40",
                            "stop": "0x41"
                        },
                        {
                            "name": "Program",
                            "priority": 3,
                            "start": "0x10",
                            "stop": "0x11"
                        },
                        {
                            "name": "Chapter",
                            "priority": 4,
                            "start": "0x20",
                            "stop": "0x21"
                        }
                    ]
                }
            }
        }
    }
}
