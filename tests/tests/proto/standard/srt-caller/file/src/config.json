{
    "version": "1.1.0",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "transport": {
                    "uri": [
                        "srt://127.0.0.1:2222/?mode=caller",
                        "srt://127.0.0.1:3333/?mode=caller"
                    ]
                }
            }
        ],

        "outputs": [
            {
                "transports": [
                    {
                        "uri": "file:///tmp/output.ts"
                    }
                ],
                "container": "mpegts",

                "streams": [
                    {
                        "type": "audio",
                        "codec": "passthrough"
                    },
                    {
                        "type": "video",
                        "codec": "passthrough"
                    }
                ]
            }
        ]
    }
}
