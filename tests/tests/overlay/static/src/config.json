{
    "version": "1.0.7",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "uri": "srt://127.0.0.1:2222/?mode=caller"
            }
        ],

        "outputs": [
            {
                "uri": "srt://127.0.0.1:4444/?mode=caller",
                "container": "mpegts",

                "scte": {
                    "pid": 600,
                    "mode": "passthrough"
                },

                "streams": [
                    {
                        "type": "audio",
                        "codec": "passthrough"
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 960,
                            "height": 540,
                            "rate": 24
                        },
                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "15",
                                "tune":         "zerolatency",
                                "speed-preset": "fast",
                                "bitrate":      "2400"
                            },
                            "caps": {
                                "profile": "high"
                            }
                        }
                    }
                ]
            }
        ]
    }
}
