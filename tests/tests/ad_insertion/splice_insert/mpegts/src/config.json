{
    "version": "1.5.0",

    "application": {
        "logger": {
            "transcoder": {
                "level": "trace",
                "console": {
                    "enable": true,
                    "colors": true
                }
            },

            "gstreamer": {
                "level": "warning",
                "console": {
                    "enable": true,
                    "colors": true
                }
            }
        }
    },

    "transcoder": {
        "inputs": [
            {
                "role": "primary",
                "transport": {
                    "uri": "srt://127.0.0.1:2222/?mode=caller"
                }
            },
            {
                "role": "secondary",
                "offAir": "pause",
                "transport": {
                    "uri": "pls+file:///tests/tests/ad_insertion/splice_insert/mpegts/tmp/ads.m3u8"
                }
            }
        ],

        "adInsertion": {
            "enable": true,
            "maxBreakDuration": 60000,
            "outputScte": "passthrough",

            "trigger": {
                "restriction": {
                    "ignore": "NONE"
                },

                "conditions": {
                    "spliceInsert": {
                        "matchWhenNoSegmentationDescriptors": true,
                        "segments": []
                    },

                    "timeSignal": {
                        "matchWhenNoSegmentationDescriptors": false,

                        "segments": [
                            {
                                "name": "Provider placement opportunity",
                                "priority": 2,
                                "start": "0x34",
                                "stop": "0x35"
                            },
                            {
                                "name": "Distributor placement opportunity",
                                "priority": 3,
                                "start": "0x36",
                                "stop": "0x37"
                            }
                        ]
                    }
                }
            }
        },

        "outputs": [
            {
                "transports": [
                    {
                        "uri": "srt://127.0.0.1:4444/?mode=caller"
                    }
                ],

                "container": "mpegts",

                "streams": [
                    {
                        "type": "audio",
                        "codec": "mp2",
                        "audio": {
                            "rate": 44100,
                            "channels": 2
                        }
                    },
                    {
                        "type": "video",
                        "codec": "h264",
                        "video": {
                            "width": 960,
                            "height": 540,
                            "rate": 24
                        },

                        "h264": {
                            "encoder": "x264enc",
                            "properties": {
                                "key-int-max":  "24",
                                "tune":         "zerolatency",
                                "speed-preset": "ultrafast",
                                "bitrate":      "3500"
                            }
                        }
                    }
                ],

                "scte": {
                    "mode": "passthrough",
                    "pid": 600
                }
            }
        ]
    }
}
